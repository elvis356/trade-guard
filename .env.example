# Backend local development values. Keep real secrets out of version control.
# PostgreSQL JDBC URL, database username, and database password.
DB_URL=jdbc:postgresql://localhost:5432/tradeguard
DB_USERNAME=tradeguard
DB_PASSWORD=tradeguard_local_only
# Redis connection details; leave REDIS_PASSWORD empty for local Redis without auth.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# JWT signing secret; set a unique random value of at least 32 bytes.
JWT_SECRET=
# Whether the session cookie requires HTTPS. Use false only for local HTTP development.
COOKIE_SECURE=true
# Exact browser origin(s) allowed to make backend API requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Shared token required by the internal end-of-day endpoint and scheduled job.
EOD_TOKEN=
# Set both only for the first startup to create the initial ADMIN account.
# Remove them after the account has been created; the account remains in the database.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
