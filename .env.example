# Docker Compose local development values. Do not use these defaults in production.
# PostgreSQL connection settings; Compose uses the postgres service as the backend host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tradeguard
# PostgreSQL username and local-only password.
DB_USERNAME=tradeguard
DB_PASSWORD=tradeguard_local_only
# PostgreSQL SSL mode: disable for local Docker Postgres.
DB_SSLMODE=disable
# Redis connection details; Compose uses the redis service as the backend host.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Local-only sample JWT signing secret (at least 32 bytes); replace for shared or deployed environments.
JWT_SECRET=tradeguard_local_only_change_before_sharing_0123456789
# Local HTTP development does not use HTTPS.
COOKIE_SECURE=false
# Browser origin allowed to make backend API requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional shared token for the internal end-of-day endpoint.
EOD_TOKEN=
# Local demo ADMIN account; keep these values only for isolated local testing.
# Never use these credentials in a deployed or internet-accessible environment.
BOOTSTRAP_ADMIN_USERNAME=amin
BOOTSTRAP_ADMIN_PASSWORD=1qaz2wsx3edc
