# Backend base URL used by the Next.js server; do not expose it with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8080
# Shared secret checked by POST /api/revalidate.
# The current backend does not call this route, so configure this only when a
# trusted caller is implemented. Set the same secret in that caller and send it
# in the X-Revalidate-Secret request header. Never expose it to browser code.
REVALIDATE_SECRET=
